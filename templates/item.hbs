<div class="item-body"><header class="item-header"><img src="{{item.img}}" data-edit="img" alt="Item artwork"><input type="text" name="name" value="{{item.name}}" aria-label="Item name"></header><p class="eyebrow">{{item.type}} · {{system.source}}</p><label>Description<textarea name="system.description" rows="4">{{system.description}}</textarea></label><div class="stat-grid"><label>Family<input name="system.family" value="{{system.family}}"></label><label>Cartridge<input name="system.cartridge" value="{{system.cartridge}}"></label><label>Compatibility<input name="system.compatibility" value="{{system.compatibility}}"></label><label>Quantity<input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label></div>
{{#if weapon}}<h2>Weapon profile</h2><div class="stat-grid"><label>Accuracy<input type="number" name="system.accuracy" value="{{system.accuracy}}" min="-5" max="5"></label><label>Harm<input type="number" name="system.harm" value="{{system.harm}}" min="0"></label><label>Penetration<input type="number" name="system.penetration" value="{{system.penetration}}" min="0"></label><label>Recoil<input type="number" name="system.recoil" value="{{system.recoil}}" min="1" max="3"></label><label>Strain<input type="number" name="system.strain" value="{{system.strain}}" min="1" max="3"></label><label>Hands<input type="number" name="system.hands" value="{{system.hands}}" min="0" max="2"></label><label>Effective range (ft)<input type="number" name="system.effective" value="{{system.effective}}" min="0" step="5"></label><label>Maximum range (ft)<input type="number" name="system.maximum" value="{{system.maximum}}" min="0" step="5"></label><label>Reach (ft)<input type="number" name="system.reach" value="{{system.reach}}" min="0" step="5"></label><label>Reload Actions<input type="number" name="system.reloadCost" value="{{system.reloadCost}}" min="1" max="3"></label><label>Installed magazine ID<input name="system.magazineId" value="{{system.magazineId}}"></label><label>Fire Actions<input type="number" name="system.fireCost" value="{{system.fireCost}}" min="1" max="3"></label></div><div class="check-grid"><label><input type="checkbox" name="system.readied" {{checked system.readied}}> Readied</label><label><input type="checkbox" name="system.deployed" {{checked system.deployed}}> Deployed</label><label><input type="checkbox" name="system.cycled" {{checked system.cycled}}> Cycled / operable</label><label><input type="checkbox" name="system.broken" {{checked system.broken}}> Broken</label></div>{{/if}}
<h2>Resources</h2><div class="stat-grid"><label>Current Load<input type="number" name="system.currentLoad" value="{{system.currentLoad}}" min="0" max="{{system.maxLoad}}"></label><label>Maximum Load<input type="number" name="system.maxLoad" value="{{system.maxLoad}}" min="1"></label><label>Reload progress<input type="number" name="system.reloadProgress" value="{{system.reloadProgress}}" min="0"></label><label>Reload source ID<input name="system.reloadSource" value="{{system.reloadSource}}"></label></div>
{{#if protection}}<h2>Protection</h2><div class="stat-grid"><label>Ballistic Armour<input type="number" name="system.ballistic" value="{{system.ballistic}}" min="0"></label><label>Melee Armour<input type="number" name="system.meleeArmour" value="{{system.meleeArmour}}" min="0"></label><label>Shield Absorption<input type="number" name="system.absorption" value="{{system.absorption}}" min="1"></label><label><input type="checkbox" name="system.worn" {{checked system.worn}}> Worn armour</label></div>{{/if}}
{{#if device}}<h2>Payload</h2><div class="stat-grid"><label>Payload<input name="system.payload" value="{{system.payload}}" placeholder="fragmentation / he / flash / concussion / smoke / incendiary / rocket"></label><label>Radius (ft)<input type="number" name="system.radius" value="{{system.radius}}" min="0"></label><label>Duration (rounds)<input type="number" name="system.duration" value="{{system.duration}}" min="0"></label></div>{{/if}}
<label>Traits (comma separated stable IDs)<input name="traitText" value="{{traitText}}" placeholder="assault, automatic, optic, manual, support, heavy, non-lethal, ballistic"></label><label>Item action IDs (comma separated)<textarea name="actionText" rows="3">{{actionText}}</textarea></label><details><summary>Available action IDs</summary><p>{{#each actions}}{{id}} · {{/each}}</p></details><label>Discipline ID<input name="system.disciplineId" value="{{system.disciplineId}}"></label><label>Action ID<input name="system.actionId" value="{{system.actionId}}"></label></div>
