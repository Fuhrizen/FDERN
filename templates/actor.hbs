<div class="sheet-layout">
  <aside class="sheet-rail">
    <img class="portrait" src="{{actor.img}}" data-action="dispatch" data-command="portrait" alt="Character portrait" role="button" tabindex="0">
    <input class="actor-name" type="text" name="name" value="{{actor.name}}" aria-label="Character name">
    <p class="eyebrow">Level {{system.tactical.level}} · FDERN</p>
    <div class="resource"><label>Wounds <input name="system.combat.wounds" type="number" min="0" max="3" value="{{system.combat.wounds}}"></label><meter min="0" max="3" value="{{system.combat.wounds}}"></meter></div>
    <div class="resource"><label>Pressure <input name="system.combat.pressure" type="number" min="0" max="7" value="{{system.combat.pressure}}"></label><meter min="0" max="7" value="{{system.combat.pressure}}"></meter><strong>{{system.tactical.pressureState}}</strong></div>
    <div class="resource-summary"><span><b>{{system.combat.actionsRemaining}}</b> Actions left</span><span><b>{{system.tactical.move}}</b> ft / Move</span><span><b>{{system.combat.attackPenalty}}</b> Recoil / Strain</span><span><b>{{system.tactical.ballistic}} / {{system.tactical.melee}}</b> B / M Armour</span></div>
    <label><input type="checkbox" name="system.combat.reactionAvailable" {{checked system.combat.reactionAvailable}}> Reaction available</label>
    {{#if system.combat.overwatch.active}}<p class="notice">Reserved {{system.combat.overwatch.kind}}: {{system.combat.overwatch.lane}}</p>{{/if}}
    <p>Stun: <b>{{stunLabel}}</b></p>
    {{#if system.combat.bleeding}}<p class="danger">Bleeding out: {{system.combat.bleedMarks}} / 3</p>{{/if}}
    {{#if system.combat.dead}}<p class="danger">Dead</p>{{/if}}
    {{#if system.combat.recoveryPending}}<p class="notice">Awaiting GM approval to return to combat.</p>{{/if}}
    {{#if isGM}}<button type="button" data-action="dispatch" data-command="recover">Approve recovery</button>{{/if}}
    {{#unless system.wizardComplete}}<button type="button" data-action="dispatch" data-command="wizard">Character wizard</button>{{/unless}}
  </aside>
  <main class="sheet-main">
    <nav class="sheet-tabs" aria-label="Character sheet tabs">{{#each tabs}}<button type="button" class="{{#if active}}active{{/if}}" data-action="dispatch" data-command="tab" data-tab="{{id}}">{{label}}</button>{{/each}}</nav>
    {{#if isCombat}}
    <section><div class="section-heading"><h2>Activation</h2><span>Select a map target before attacking.</span></div><div class="action-grid">{{#each universal}}<button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" title="{{reason}}" {{#if disabled}}disabled{{/if}}><b>{{name}}</b><small>{{cost}} A</small></button>{{/each}}</div></section>
    <section><h2>Weapons & equipment</h2>{{#each weapons}}<article class="equipment-card {{#if system.readied}}readied{{/if}}"><div class="section-heading"><button class="text-button" type="button" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span>{{system.slot}} {{#if system.readied}}· Readied{{/if}} {{#if system.deployed}}· Deployed{{/if}} {{#if system.broken}}· Broken{{/if}}</span></div><p class="muted">{{traitLabels}} · Harm {{system.harm}} / Pen {{system.penetration}} · Load {{load}} / {{maxLoad}}</p><div class="action-grid"><button type="button" data-action="dispatch" data-command="ready" data-id="{{_id}}">Ready / Stow <small>1 A</small></button><button type="button" data-action="dispatch" data-command="act" data-action-id="aim" data-item="{{_id}}">Aim <small>1 A</small></button>{{#each actionRows}}<button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" data-item="{{item}}" title="{{reason}}" {{#if disabled}}disabled{{/if}}><b>{{name}}</b><small>{{cost}} A{{#if load}} · {{load}} Load{{/if}}</small></button>{{/each}}</div></article>{{/each}}</section>
    <section><h2>Unarmed</h2><div class="action-grid">{{#each unarmed}}<button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" title="{{reason}}" {{#if disabled}}disabled{{/if}}>{{name}}<small>{{cost}} A</small></button>{{/each}}</div></section>
    {{/if}}
    {{#if isSkills}}<section><h2>Attributes</h2><div class="stat-grid">{{#each attributes}}<label>{{label}}{{#if ../isGM}}<input type="number" name="system.attributes.{{id}}" min="0" max="3" value="{{value}}">{{else}}<b>{{value}}</b>{{/if}}</label>{{/each}}</div></section><section><h2>Skills</h2><div class="skill-grid">{{#each skills}}<div class="skill-row"><button type="button" class="text-button" data-action="dispatch" data-command="test" data-skill="{{id}}">{{label}}</button><small>{{pairing}}</small>{{#if ../isGM}}<input type="number" name="system.skills.{{id}}" min="0" max="4" value="{{value}}">{{else}}<b>{{value}}</b>{{/if}}</div>{{/each}}</div></section><section><h2>Disciplines</h2>{{#each disciplines}}<p><b>{{name}}</b> · {{system.description}}</p>{{else}}<p>No Disciplines learned.</p>{{/each}}</section>{{/if}}
    {{#if isEquipment}}<section><div class="section-heading"><h2>Loadout</h2><button type="button" data-action="dispatch" data-command="item-create">Add equipment</button></div><p>Drag items from the Equipment compendium. Three accessible slots; two usable hands.</p>{{#each weapons}}<div class="inventory-row" data-drag-item="{{_id}}"><button type="button" class="text-button" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span>{{system.slot}}</span><button type="button" data-action="dispatch" data-command="slot" data-id="{{_id}}">Slot</button><button type="button" data-action="dispatch" data-command="ready" data-id="{{_id}}">{{#if system.readied}}Stow{{else}}Ready{{/if}}</button><button type="button" data-action="dispatch" data-command="item-delete" data-id="{{_id}}" aria-label="Remove {{name}}">×</button></div>{{/each}}</section><section><h2>Worn protection</h2>{{#each armour}}<div class="inventory-row"><button type="button" class="text-button" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span>B {{system.ballistic}} / M {{system.meleeArmour}}</span><span>{{#if system.worn}}Worn{{else}}Stored{{/if}}</span></div>{{/each}}</section><section><div class="section-heading"><h2>Individual magazines</h2><button type="button" data-action="dispatch" data-command="repack">Repack outside combat</button></div>{{#each magazines}}<div class="inventory-row" data-drag-item="{{_id}}"><button type="button" class="text-button" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span>{{system.compatibility}}</span><b>{{system.currentLoad}} / {{system.maxLoad}} Load</b></div>{{/each}}</section>{{/if}}
    {{#if isBiography}}<section><h2>Character</h2><label>Background<textarea name="system.biography.background" rows="3">{{system.biography.background}}</textarea></label><label>Description<textarea name="system.biography.description" rows="5">{{system.biography.description}}</textarea></label><label>Motivation<textarea name="system.biography.motivation" rows="3">{{system.biography.motivation}}</textarea></label><label>Connection or complication<textarea name="system.biography.connection" rows="3">{{system.biography.connection}}</textarea></label></section>{{/if}}
    {{#if isMemory}}<section class="notebook"><div class="section-heading"><h2>Memory</h2>{{#if isOwner}}<button type="button" data-action="dispatch" data-command="note-add">New memory</button><button type="button" data-action="dispatch" data-command="tag-colour">Tag colour</button>{{/if}}</div><input data-memory-search type="search" value="{{search}}" placeholder='Search notes, phrases or tag:"field notes"' aria-label="Search memories">{{#each notes}}<article class="memory-card"><div class="section-heading"><button type="button" class="text-button" data-action="dispatch" data-command="note-open" data-id="{{id}}">{{title}}</button>{{#if ../isOwner}}<button type="button" data-action="dispatch" data-command="note-edit" data-id="{{id}}">Edit</button><button type="button" data-action="dispatch" data-command="note-delete" data-id="{{id}}">Delete</button>{{/if}}</div><div class="tag-list">{{#each tagRows}}<span class="tag" style="{{style}}">{{label}}</span>{{/each}}</div>{{#if open}}<div class="note-content">{{{html}}}</div>{{/if}}</article>{{else}}<p>No matching memories.</p>{{/each}}</section>{{/if}}
    {{#if isAdvancement}}<section><div class="section-heading"><h2>Veterancy</h2>{{#if isGM}}<button type="button" data-action="dispatch" data-command="award">Award VP</button>{{/if}}</div><div class="stat-grid"><div><b>{{system.advancement.lifetimeVP}}</b> lifetime VP</div><div><b>{{system.advancement.spentVP}}</b> spent VP</div><div><b>{{system.tactical.availableVP}}</b> available VP</div></div><p>Levels grant no automatic combat bonuses. Spend VP to develop this character.</p><h3>Skills</h3><div class="skill-grid">{{#each skills}}<div class="skill-row"><span>{{label}} {{value}}</span><button type="button" data-action="dispatch" data-command="purchase" data-kind="skill" data-key="{{id}}" {{#if capped}}disabled{{/if}}>Increase · {{cost}} VP</button></div>{{/each}}</div><h3>Attributes · one lifetime purchase, 12 VP</h3><div class="action-grid">{{#each attributes}}<button type="button" data-action="dispatch" data-command="purchase" data-kind="attribute" data-key="{{id}}">{{label}} {{value}} → +1</button>{{/each}}</div><h3>Disciplines</h3>{{#each availableDisciplines}}<div class="skill-row"><span>{{name}} <small>{{skill}} {{rank}}{{#if advanced}} · Advanced{{/if}}</small></span><button type="button" data-action="dispatch" data-command="purchase" data-kind="discipline" data-key="{{id}}" {{#unless eligible}}disabled{{/unless}} {{#if learned}}disabled{{/if}}>{{#if learned}}Learned{{else}}{{cost}} VP{{/if}}</button></div>{{/each}}</section>{{/if}}
  </main>
</div>
