<div class="item-body">
  <header class="item-header"><img src="{{item.img}}" alt="{{item.name}}"><div class="form-group"><label for="{{sheetId}}-name">Name</label><div class="form-fields"><input id="{{sheetId}}-name" name="name" value="{{item.name}}"></div></div></header>
  <fieldset><legend>Details</legend><div class="form-group stacked"><label for="{{sheetId}}-description">Description</label><textarea id="{{sheetId}}-description" name="system.description" rows="4">{{system.description}}</textarea></div><div class="profile-grid"><div class="form-group"><label for="{{sheetId}}-family">Family</label><div class="form-fields"><input id="{{sheetId}}-family" name="system.family" value="{{system.family}}"></div></div><div class="form-group"><label for="{{sheetId}}-quantity">Quantity</label><div class="form-fields"><input id="{{sheetId}}-quantity" name="system.quantity" type="number" min="0" value="{{system.quantity}}"></div></div></div></fieldset>
  {{#if weapon}}<fieldset><legend>Weapon profile</legend><div class="profile-grid">{{#each weaponFields}}<div class="form-group"><label for="{{../sheetId}}-{{key}}">{{label}}</label><div class="form-fields"><input id="{{../sheetId}}-{{key}}" name="system.{{key}}" type="{{type}}" min="{{min}}" {{#if max}}max="{{max}}"{{/if}} {{#if step}}step="{{step}}"{{/if}} value="{{value}}"></div></div>{{/each}}</div><div class="check-grid">{{#each checks}}<label><input name="system.{{key}}" type="checkbox" {{checked value}}> {{label}}</label>{{/each}}</div></fieldset>{{/if}}
  {{#if resource}}<fieldset><legend>Ammunition and supplies</legend><div class="profile-grid">{{#each resourceFields}}<div class="form-group"><label for="{{../sheetId}}-{{key}}">{{label}}</label><div class="form-fields"><input id="{{../sheetId}}-{{key}}" name="system.{{key}}" type="{{type}}" min="{{min}}" {{#if max}}max="{{max}}"{{/if}} value="{{value}}"></div></div>{{/each}}</div>{{#if firearm}}{{#if embedded}}<div class="form-group"><label for="{{sheetId}}-source">Installed source</label><div class="form-fields"><select id="{{sheetId}}-source" name="system.magazineId"><option value="">None / internal supply</option>{{#each sources}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div></div><p class="hint">Use Reload during combat to pay Actions and preserve ammunition.</p>{{/if}}{{/if}}<div class="profile-grid"><div class="form-group"><label for="{{sheetId}}-cartridge">Cartridge</label><div class="form-fields"><input id="{{sheetId}}-cartridge" name="system.cartridge" value="{{system.cartridge}}"></div></div><div class="form-group"><label for="{{sheetId}}-compatibility">Compatibility</label><div class="form-fields"><input id="{{sheetId}}-compatibility" name="system.compatibility" value="{{system.compatibility}}"></div></div></div></fieldset>{{/if}}
  {{#if protection}}<fieldset><legend>Protection</legend>{{#each protectionFields}}<div class="form-group"><label for="{{../sheetId}}-{{key}}">{{label}}</label><div class="form-fields"><input id="{{../sheetId}}-{{key}}" name="system.{{key}}" type="number" min="{{min}}" value="{{value}}"></div></div>{{/each}}{{#unless weapon}}{{#each checks}}<label><input type="checkbox" name="system.{{key}}" {{checked value}}> {{label}}</label>{{/each}}{{/unless}}</fieldset>{{/if}}
  {{#if device}}<fieldset><legend>Payload</legend><div class="form-group"><label for="{{sheetId}}-payload">Payload</label><div class="form-fields"><input id="{{sheetId}}-payload" name="system.payload" value="{{system.payload}}"></div></div><div class="form-group"><label for="{{sheetId}}-radius">Radius (ft)</label><div class="form-fields"><input id="{{sheetId}}-radius" type="number" name="system.radius" min="0" value="{{system.radius}}"></div></div><div class="form-group"><label for="{{sheetId}}-duration">Duration (rounds)</label><div class="form-fields"><input id="{{sheetId}}-duration" type="number" name="system.duration" min="0" value="{{system.duration}}"></div></div></fieldset>{{/if}}
  <details><summary>Item actions</summary><p class="hint">Choose the actions this item supplies. Training, readiness, Actions and Load are checked when used.</p><div class="check-grid">{{#each actions}}<label><input type="checkbox" name="actionChoices.{{id}}" {{checked selected}}> {{name}}</label>{{/each}}</div></details>
  <details><summary>Configuration</summary><div class="form-group"><label for="{{sheetId}}-img">Artwork</label><div class="form-fields"><input id="{{sheetId}}-img" name="img" value="{{item.img}}"></div></div><div class="form-group stacked"><label for="{{sheetId}}-traits">Traits (comma separated)</label><input id="{{sheetId}}-traits" name="traitText" value="{{traitText}}"></div>{{#if discipline}}<div class="form-group"><label for="{{sheetId}}-discipline">Discipline identifier</label><div class="form-fields"><input id="{{sheetId}}-discipline" name="system.disciplineId" value="{{system.disciplineId}}"></div></div>{{/if}}<p class="hint">Source: {{system.source}}</p></details>
</div>
