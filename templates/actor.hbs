<div class="fdern-sheet">
  <header class="sheet-header">
    <button type="button" class="portrait-button plain" data-action="dispatch" data-command="portrait" aria-label="Change character portrait" {{#unless editable}}disabled{{/unless}}><img class="portrait" src="{{actor.img}}" alt="{{actor.name}}"></button>
    <div class="identity">
      <div class="form-group"><label for="{{sheetId}}-name">Name</label><div class="form-fields"><input id="{{sheetId}}-name" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></div></div>
      <p class="hint">Level {{system.tactical.level}} · {{system.tactical.pressureState}} · Stun: {{stunLabel}}</p>
      {{#unless system.wizardComplete}}{{#if editable}}<button type="button" data-action="dispatch" data-command="wizard"><i class="fa-solid fa-user-plus" inert></i> Character wizard</button>{{/if}}{{/unless}}
    </div>
  </header>
  <fieldset class="combat-summary"><legend>Combat resources</legend>
    <div class="resource-fields">
      <div class="form-group"><label for="{{sheetId}}-wounds">Wounds</label><div class="form-fields"><input id="{{sheetId}}-wounds" name="system.combat.wounds" type="number" min="0" max="3" value="{{system.combat.wounds}}" {{#unless editable}}disabled{{/unless}}><span>/ 3</span></div></div>
      <div class="form-group"><label for="{{sheetId}}-pressure">Pressure</label><div class="form-fields"><input id="{{sheetId}}-pressure" name="system.combat.pressure" type="number" min="0" max="7" value="{{system.combat.pressure}}" {{#unless editable}}disabled{{/unless}}><span>/ 7</span></div></div>
      <div class="form-group"><label for="{{sheetId}}-reaction">Reaction available</label><div class="form-fields"><input id="{{sheetId}}-reaction" type="checkbox" name="system.combat.reactionAvailable" {{checked system.combat.reactionAvailable}} {{#unless editable}}disabled{{/unless}}></div></div>
    </div>
    <dl class="summary-values"><div><dt>Actions left</dt><dd>{{system.combat.actionsRemaining}}</dd></div><div><dt>Move</dt><dd>{{system.tactical.move}} ft</dd></div><div><dt>Recoil / Strain</dt><dd>{{system.combat.attackPenalty}}</dd></div><div><dt>Armour (B / M)</dt><dd>{{system.tactical.ballistic}} / {{system.tactical.melee}}</dd></div></dl>
    {{#if system.combat.overwatch.active}}<p class="notification info">Reserved {{system.combat.overwatch.kind}}: {{system.combat.overwatch.lane}}</p>{{/if}}
    {{#if system.combat.bleeding}}<p class="notification warning">Bleeding out: {{system.combat.bleedMarks}} / 3</p>{{/if}}
    {{#if system.combat.dead}}<p class="notification error">Dead</p>{{/if}}
    {{#if system.combat.recoveryPending}}<p class="notification info">Awaiting GM approval to return to combat. {{#if isGM}}<button type="button" data-action="dispatch" data-command="recover">Approve recovery</button>{{/if}}</p>{{/if}}
  </fieldset>
  <nav class="tabs sheet-tabs" data-group="sheet" aria-label="Character sheet tabs">{{#each tabRows}}<button type="button" class="plain {{cssClass}}" data-action="tab" data-group="sheet" data-tab="{{id}}" {{#if active}}aria-current="page"{{/if}}><i class="{{icon}}" inert></i> {{label}}</button>{{/each}}</nav>
  <div class="sheet-body">
    <section class="tab {{#if isCombat}}active{{/if}}" data-group="sheet" data-tab="combat">
      <fieldset><legend>Actions</legend><div class="action-list">{{#each universal}}<div class="action-row"><span>{{name}}</span><span class="hint">{{cost}} A</span><button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" {{#if disabled}}disabled{{/if}} aria-label="Use {{name}}">Use</button>{{#if reason}}<small class="hint action-reason">{{reason}}</small>{{/if}}</div>{{/each}}</div></fieldset>
      <h3>Equipment actions</h3>
      {{#each weapons}}<fieldset data-drag-item="{{_id}}"><legend>{{name}}</legend>
        <div class="section-heading"><span class="hint">{{#if system.readied}}Readied{{else}}Stowed{{/if}}{{#if system.deployed}} · Deployed{{/if}}{{#if system.broken}} · Broken{{/if}}</span><button class="inline-control" type="button" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">Details</button></div>
        <p class="hint">{{#if isWeapon}}Harm {{system.harm}} · Pen {{system.penetration}}{{/if}}{{#if usesLoad}} · Load {{load}} / {{maxLoad}}{{/if}}{{#if traitLabels}} · {{traitLabels}}{{/if}}</p>
        <div class="action-list">{{#each actionRows}}<div class="action-row"><span>{{name}}</span><span class="hint">{{cost}} A{{#if load}} · {{load}} Load{{/if}}</span><button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" data-item="{{item}}" {{#if disabled}}disabled{{/if}} aria-label="Use {{name}} with {{../name}}">Use</button>{{#if reason}}<small class="hint action-reason">{{reason}}</small>{{/if}}</div>{{/each}}</div>
      </fieldset>{{else}}<p class="hint">Add equipment from the compendium on the Equipment tab.</p>{{/each}}
      <details><summary>Unarmed actions</summary><div class="action-list">{{#each unarmed}}<div class="action-row"><span>{{name}}</span><span class="hint">{{cost}} A</span><button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" {{#if disabled}}disabled{{/if}} aria-label="Use unarmed {{name}}">Use</button>{{#if reason}}<small class="hint action-reason">{{reason}}</small>{{/if}}</div>{{/each}}</div></details>
    </section>
    <section class="tab {{#if isSkills}}active{{/if}}" data-group="sheet" data-tab="skills">
      <fieldset><legend>Attributes</legend><div class="profile-grid">{{#each attributes}}<div class="form-group"><label for="{{../sheetId}}-attribute-{{id}}">{{label}}</label><div class="form-fields"><input id="{{../sheetId}}-attribute-{{id}}" type="number" name="system.attributes.{{id}}" min="0" max="3" value="{{value}}" {{#unless ../isGM}}disabled{{/unless}}></div></div>{{/each}}</div></fieldset>
      <fieldset><legend>Skills</legend><div class="profile-grid">{{#each skills}}<div class="skill-row"><button type="button" class="skill-test" data-action="dispatch" data-command="test" data-skill="{{id}}" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-dice" inert></i> {{label}}</button><span class="hint">{{pairing}}</span><input aria-label="{{label}} rank" type="number" name="system.skills.{{id}}" min="0" max="4" value="{{value}}" {{#unless ../isGM}}disabled{{/unless}}></div>{{/each}}</div></fieldset>
      <fieldset><legend>Disciplines</legend>{{#each disciplines}}<p><strong>{{name}}</strong> · {{system.description}}</p>{{else}}<p class="hint">No Disciplines learned.</p>{{/each}}</fieldset>
    </section>
    <section class="tab {{#if isEquipment}}active{{/if}}" data-group="sheet" data-tab="equipment">
      <div class="section-heading"><h3>Loadout</h3>{{#if editable}}<button class="inline-control" type="button" data-action="dispatch" data-command="item-create"><i class="fa-solid fa-plus" inert></i> Add equipment</button>{{/if}}</div>
      <p class="hint">Drag equipment from the compendium. Three accessible slots; two usable hands. Drag an item to the hotbar to create a macro.</p>
      {{#each weapons}}<div class="inventory-row" data-drag-item="{{_id}}"><button type="button" class="item-name" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span class="hint">{{slotLabel}}</span>{{#if ../editable}}<div class="row-actions"><button type="button" data-action="dispatch" data-command="slot" data-id="{{_id}}">Slot</button><button type="button" data-action="dispatch" data-command="ready" data-id="{{_id}}" {{#if readyRow.disabled}}disabled{{/if}} title="{{readyRow.reason}}">{{#if system.readied}}Stow{{else}}Ready{{/if}}</button><button type="button" class="icon" data-action="dispatch" data-command="item-delete" data-id="{{_id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash" inert></i></button></div>{{/if}}</div>{{/each}}
      <fieldset><legend>Protection</legend>{{#each armour}}<div class="inventory-row"><button type="button" class="item-name" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span>B {{system.ballistic}} / M {{system.meleeArmour}}</span><span>{{#if system.worn}}Worn{{else}}Stored{{/if}}</span></div>{{else}}<p class="hint">No armour carried.</p>{{/each}}</fieldset>
      <fieldset><legend>Ammunition sources</legend>{{#if editable}}<button type="button" class="inline-control" data-action="dispatch" data-command="repack">Repack outside combat</button>{{/if}}{{#each magazines}}<div class="inventory-row" data-drag-item="{{_id}}"><button type="button" class="item-name" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span class="hint">{{system.compatibility}}</span><strong>{{system.currentLoad}} / {{system.maxLoad}} Load</strong></div>{{else}}<p class="hint">No ammunition sources carried.</p>{{/each}}</fieldset>
    </section>
    <section class="tab {{#if isBiography}}active{{/if}}" data-group="sheet" data-tab="biography"><fieldset><legend>Character</legend>{{#each biographyFields}}<div class="form-group stacked"><label for="{{../sheetId}}-bio-{{id}}">{{label}}</label><textarea id="{{../sheetId}}-bio-{{id}}" name="system.biography.{{id}}" rows="3" {{#unless ../editable}}disabled{{/unless}}>{{value}}</textarea></div>{{/each}}</fieldset></section>
    <section class="tab {{#if isMemory}}active{{/if}}" data-group="sheet" data-tab="memory"><div class="notebook">
      <div class="section-heading"><h3>Memory</h3>{{#if editable}}<div class="row-actions"><button type="button" data-action="dispatch" data-command="note-add">New memory</button><button type="button" data-action="dispatch" data-command="tag-colour">Tag colour</button></div>{{/if}}</div>
      <search><input data-memory-search type="search" value="{{search}}" placeholder='Search notes, phrases or tag:"field notes"' aria-label="Search memories"></search>
      {{#each notes}}<fieldset class="memory-entry"><legend>{{title}}</legend><div class="section-heading"><button type="button" class="inline-control" data-action="dispatch" data-command="note-open" data-id="{{id}}" aria-expanded="{{open}}">{{#if open}}Collapse{{else}}Read memory{{/if}}</button>{{#if ../editable}}<div class="row-actions"><button type="button" data-action="dispatch" data-command="note-edit" data-id="{{id}}">Edit</button><button type="button" data-action="dispatch" data-command="note-delete" data-id="{{id}}">Delete</button></div>{{/if}}</div><div class="tag-list">{{#each tagRows}}<span class="tag" style="{{style}}">{{label}}</span>{{/each}}</div>{{#if open}}<div class="note-content">{{{html}}}</div>{{/if}}</fieldset>{{else}}<p class="hint">No matching memories.</p>{{/each}}
    </div></section>
    <section class="tab {{#if isAdvancement}}active{{/if}}" data-group="sheet" data-tab="advancement">
      <div class="section-heading"><h3>Veterancy</h3>{{#if isGM}}<button class="inline-control" type="button" data-action="dispatch" data-command="award">Award VP</button>{{/if}}</div>
      <dl class="summary-values"><div><dt>Lifetime VP</dt><dd>{{system.advancement.lifetimeVP}}</dd></div><div><dt>Spent VP</dt><dd>{{system.advancement.spentVP}}</dd></div><div><dt>Available VP</dt><dd>{{system.tactical.availableVP}}</dd></div></dl><p class="hint">Levels grant no automatic combat bonuses.</p>
      <fieldset><legend>Skills</legend><div class="profile-grid">{{#each skills}}<div class="purchase-row"><span>{{label}} {{value}}</span><button type="button" data-action="dispatch" data-command="purchase" data-kind="skill" data-key="{{id}}" {{#if purchaseDisabled}}disabled{{/if}}>+1 · {{cost}} VP</button></div>{{/each}}</div></fieldset>
      <fieldset><legend>Attributes</legend><p class="hint">One lifetime purchase · 12 VP</p><div class="profile-grid">{{#each attributes}}<div class="purchase-row"><span>{{label}} {{value}}</span><button type="button" data-action="dispatch" data-command="purchase" data-kind="attribute" data-key="{{id}}" {{#if purchaseDisabled}}disabled{{/if}}>+1 · 12 VP</button></div>{{/each}}</div></fieldset>
      <fieldset><legend>Disciplines</legend>{{#each availableDisciplines}}<div class="purchase-row"><span>{{name}}<small class="hint">{{skillLabel}} {{rank}}{{#if advanced}} · Advanced{{/if}}</small></span><button type="button" data-action="dispatch" data-command="purchase" data-kind="discipline" data-key="{{id}}" {{#if disabled}}disabled{{/if}}>{{#if learned}}Learned{{else}}{{cost}} VP{{/if}}</button></div>{{/each}}</fieldset>
    </section>
  </div>
</div>
