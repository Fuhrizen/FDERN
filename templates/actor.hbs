<div class="fdern-sheet">
  <header class="sheet-header">
    <button type="button" class="portrait-button plain" data-action="dispatch" data-command="portrait" aria-label="Change character portrait" {{#unless editable}}disabled{{/unless}}><img class="portrait" src="{{actor.img}}" alt="{{actor.name}}"></button>
    <div class="identity">
      <div class="form-group"><label for="{{sheetId}}-name">Name</label><div class="form-fields"><input id="{{sheetId}}-name" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></div></div>
      <p class="hint">Level {{system.tactical.level}} · {{system.tactical.pressureState}}{{#if system.combat.wounds}} · {{system.combat.wounds}} / 3 Wounds{{/if}}{{#if system.combat.stunEffect}} · {{stunLabel}}{{/if}}</p>
    </div>
  </header>

  <nav class="tabs sheet-tabs" data-group="sheet" aria-label="Character sheet tabs">{{#each tabRows}}<button type="button" class="plain {{cssClass}}" data-action="tab" data-group="sheet" data-tab="{{id}}" {{#if active}}aria-current="page"{{/if}}><i class="{{icon}}" inert></i> {{label}}</button>{{/each}}</nav>
  <div class="sheet-body">
    <section class="tab {{#if isCombat}}active{{/if}}" data-group="sheet" data-tab="combat">
  <fieldset class="combat-summary"><legend>Combat resources</legend>
    <div class="resource-fields">
      <div class="form-group"><label for="{{sheetId}}-wounds">Wounds</label><div class="form-fields"><input id="{{sheetId}}-wounds" name="system.combat.wounds" type="number" min="0" max="3" value="{{system.combat.wounds}}" {{#unless editable}}disabled{{/unless}}><span>/ 3</span></div></div>
      <div class="form-group"><label for="{{sheetId}}-pressure">Pressure</label><div class="form-fields"><input id="{{sheetId}}-pressure" name="system.combat.pressure" type="number" min="0" max="7" value="{{system.combat.pressure}}" {{#unless editable}}disabled{{/unless}}><span>/ 7</span></div></div>
      <div class="form-group"><label for="{{sheetId}}-reaction">Reaction</label><div class="form-fields"><input id="{{sheetId}}-reaction" type="checkbox" name="system.combat.reactionAvailable" {{checked system.combat.reactionAvailable}} {{#unless editable}}disabled{{/unless}}></div></div>
    </div>
    <dl class="summary-values"><div><dt>Actions left</dt><dd>{{system.combat.actionsRemaining}}</dd></div><div><dt>Move</dt><dd>{{system.tactical.move}} ft</dd></div><div><dt>Recoil / Strain</dt><dd>{{system.combat.attackPenalty}}</dd></div><div><dt>Armour (B / M)</dt><dd>{{system.tactical.ballistic}} / {{system.tactical.melee}}</dd></div></dl>
    {{#if system.combat.overwatch.active}}<p class="notification info">Reserved {{system.combat.overwatch.kind}}: {{system.combat.overwatch.lane}}</p>{{/if}}
    {{#if system.combat.bleeding}}<p class="notification warning">Bleeding out: {{system.combat.bleedMarks}} / 3</p>{{/if}}
    {{#if system.combat.dead}}<p class="notification error">Dead</p>{{/if}}
    {{#if system.combat.recoveryPending}}<p class="notification info">Awaiting GM approval to return to combat. {{#if isGM}}<button type="button" data-action="dispatch" data-command="recover">Approve recovery</button>{{/if}}</p>{{/if}}
  </fieldset>
      <details data-disclosure="general"><summary>General actions</summary><div class="action-list">{{#each universal}}<div class="action-row"><span>{{name}}</span><span class="hint">{{cost}} A</span><button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" {{#if disabled}}disabled{{/if}} aria-label="Use {{name}}">Use</button>{{#if reason}}<small class="hint action-reason">{{reason}}</small>{{/if}}</div>{{/each}}</div></details>
      {{#each combatWeapons}}<fieldset data-drag-item="{{_id}}"><legend>{{name}}</legend>
        <div class="section-heading"><span class="hint">{{#if system.readied}}Readied{{else}}Stowed{{/if}}{{#if system.deployed}} · Deployed{{/if}}{{#if system.broken}} · Broken{{/if}}</span><button class="inline-control" type="button" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">Details</button></div>
        <p class="hint">{{#if isWeapon}}Harm {{system.harm}} · Pen {{system.penetration}}{{/if}}{{#if usesLoad}} · Load {{load}} / {{maxLoad}}{{/if}}{{#if traitLabels}} · {{traitLabels}}{{/if}}</p>
        <div class="action-list">{{#each actionRows}}<div class="action-row"><span>{{name}}</span><span class="hint">{{cost}} A{{#if load}} · {{load}} Load{{/if}}</span><button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" data-item="{{item}}" {{#if disabled}}disabled{{/if}} aria-label="Use {{name}} with {{../name}}">Use</button>{{#if reason}}<small class="hint action-reason">{{reason}}</small>{{/if}}</div>{{/each}}</div>
      </fieldset>{{else}}<p class="hint">Add equipment from the compendium on the Equipment tab.</p>{{/each}}
      <details data-disclosure="unarmed"><summary>Unarmed actions</summary><div class="action-list">{{#each unarmed}}<div class="action-row"><span>{{name}}</span><span class="hint">{{cost}} A</span><button type="button" data-action="dispatch" data-command="act" data-action-id="{{id}}" {{#if disabled}}disabled{{/if}} aria-label="Use unarmed {{name}}">Use</button>{{#if reason}}<small class="hint action-reason">{{reason}}</small>{{/if}}</div>{{/each}}</div></details>

    </section>
    <section class="tab {{#if isSkills}}active{{/if}}" data-group="sheet" data-tab="skills">
      <div class="sheet-toolbar"><search><input type="search" data-sheet-search="skills" value="{{skillQuery}}" placeholder="Find a skill or Attribute…" aria-label="Find a skill"></search><button type="button" data-action="dispatch" data-command="trained" aria-pressed="{{trainedOnly}}">{{#if trainedOnly}}Show all skills{{else}}Trained only{{/if}}</button></div>
      <p class="hint">Roll 2d6 plus the shown bonus. You can choose another Attribute in the roll dialog.</p>
      <div class="skill-list">{{#each skillRows}}<div class="skill-play-row"><div><strong>{{label}}</strong><small class="hint">{{attribute}} {{attributeRank}} + Skill {{rank}}{{#unless trained}} · Untrained{{/unless}}</small></div><button type="button" data-action="dispatch" data-command="test" data-skill="{{id}}" aria-label="Roll {{rollLabel}}" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-dice" inert></i> Roll +{{total}}</button></div>{{else}}<p class="hint">No skills match your search.</p>{{/each}}</div>
      <fieldset><legend>Attributes</legend><dl class="summary-values">{{#each attributes}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl></fieldset>
      <fieldset><legend>Learned Disciplines</legend>{{#each disciplines}}<div class="discipline-row"><button type="button" class="inline-control" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><span class="hint">{{skillLabel}} {{rank}}{{#if benefits}} · {{benefits}}{{/if}}</span></div>{{else}}<p class="hint">Your Disciplines appear here after creation or advancement.</p>{{/each}}</fieldset>
      {{#if isGM}}<details data-disclosure="ranks"><summary>Adjust ranks</summary><p class="hint">For corrections. Use Advance to spend VP on improvements.</p><div class="profile-grid">{{#each attributes}}<div class="form-group"><label for="{{../sheetId}}-attribute-{{id}}">{{label}}</label><div class="form-fields"><input id="{{../sheetId}}-attribute-{{id}}" type="number" name="system.attributes.{{id}}" min="0" max="3" value="{{value}}"></div></div>{{/each}}{{#each skills}}<div class="form-group"><label for="{{../sheetId}}-skill-{{id}}">{{label}}</label><div class="form-fields"><input id="{{../sheetId}}-skill-{{id}}" type="number" name="system.skills.{{id}}" min="0" max="4" value="{{value}}"></div></div>{{/each}}</div></details>{{/if}}
    </section>
    <section class="tab {{#if isEquipment}}active{{/if}}" data-group="sheet" data-tab="equipment">
      <div class="sheet-toolbar"><search><input type="search" data-sheet-search="inventory" value="{{inventoryQuery}}" placeholder="Find equipment, ammunition or supplies…" aria-label="Find equipment"></search><button type="button" data-action="dispatch" data-command="browse"><i class="fa-solid fa-book-open" inert></i> Browse equipment</button></div>
      <p><strong>{{handsUsed}} / 2 hands in use</strong> · {{heldNames}}</p>{{#if inEncounter}}<p class="hint">Ready and stow items during your activation. Reorganize your loadout after the encounter.</p>{{/if}}
      <div class="loadout-grid">{{#each loadoutSlots}}<fieldset><legend>{{label}}</legend>{{#if item}}<button type="button" class="item-name" data-action="dispatch" data-command="edit-item" data-id="{{item._id}}">{{item.name}}</button><span class="hint">{{#if item.system.readied}}In hand{{else}}Accessible{{/if}}</span>{{else}}<p class="hint">Empty slot</p>{{/if}}{{#if ../canManageInventory}}<button type="button" data-action="dispatch" data-command="assign-slot" data-slot="{{id}}">{{#if item}}Change{{else}}Choose equipment{{/if}}</button>{{/if}}</fieldset>{{/each}}</div>
      {{#each inventoryGroups}}<fieldset><legend>{{label}}</legend>{{#each items}}<div class="inventory-row" data-drag-item="{{_id}}"><div class="inventory-name"><button type="button" class="item-name" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><small class="hint">{{slotLabel}}{{#if usesLoad}} · {{load}} / {{maxLoad}} Load{{/if}}{{#if system.broken}} · Broken{{else}}{{#if system.readied}} · In hand{{/if}}{{/if}}</small></div>{{#if ../../editable}}<div class="row-actions">{{#if needsReady}}<button type="button" data-action="dispatch" data-command="ready" data-id="{{_id}}" {{#if readyRow.disabled}}disabled{{/if}} title="{{readyRow.reason}}">{{#if system.readied}}Stow{{else}}Ready{{/if}}</button>{{/if}}{{#if canQuantity}}<button class="icon" type="button" data-action="dispatch" data-command="quantity" data-id="{{_id}}" data-delta="-1" aria-label="Use one {{name}}" {{#unless ../../canManageInventory}}disabled{{/unless}} {{#if quantityEmpty}}disabled{{/if}}>−</button><span aria-label="Quantity">{{system.quantity}}</span><button class="icon" type="button" data-action="dispatch" data-command="quantity" data-id="{{_id}}" data-delta="1" aria-label="Add one {{name}}" {{#unless ../../canManageInventory}}disabled{{/unless}}>+</button>{{/if}}{{#if ../../canManageInventory}}<button type="button" data-action="dispatch" data-command="slot" data-id="{{_id}}">Move</button><button type="button" class="icon" data-action="dispatch" data-command="item-delete" data-id="{{_id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash" inert></i></button>{{/if}}</div>{{/if}}</div>{{else}}<p class="hint">{{emptyLabel}}</p>{{/each}}</fieldset>{{/each}}
      <fieldset><legend>Armour</legend>{{#each armour}}<div class="inventory-row"><div class="inventory-name"><button type="button" class="item-name" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><small class="hint">Ballistic {{system.ballistic}} · Melee {{system.meleeArmour}}</small></div>{{#if ../canManageInventory}}<button type="button" class="inline-control" data-action="dispatch" data-command="wear" data-id="{{_id}}">{{#if system.worn}}Remove armour{{else}}Wear{{/if}}</button>{{else}}<span>{{#if system.worn}}Worn{{else}}Carried{{/if}}</span>{{/if}}</div>{{else}}<p class="hint">No matching armour. Browse equipment to add protection.</p>{{/each}}</fieldset>
      <fieldset><legend>Ammunition</legend>{{#each magazines}}<div class="inventory-row" data-drag-item="{{_id}}"><div class="inventory-name"><button type="button" class="item-name" data-action="dispatch" data-command="edit-item" data-id="{{_id}}">{{name}}</button><small class="hint">{{system.cartridge}} · {{installedIn}}</small></div><strong>{{system.currentLoad}} / {{system.maxLoad}} Load</strong></div>{{else}}<p class="hint">No matching ammunition. Reload with a compatible source carried by this character.</p>{{/each}}{{#if canManageInventory}}<button type="button" class="inline-control" data-action="dispatch" data-command="repack">Consolidate ammunition</button>{{/if}}</fieldset>
      {{#if editable}}<details data-disclosure="custom-equipment"><summary>Custom equipment</summary><p class="hint">For items supplied by your GM that are not in the compendium.</p><button type="button" class="inline-control" data-action="dispatch" data-command="item-create">Create an item</button></details>{{/if}}
    </section>
    <section class="tab {{#if isBiography}}active{{/if}}" data-group="sheet" data-tab="biography">
      {{#unless system.wizardComplete}}{{#if editable}}<fieldset><legend>Make this character your own</legend><p>Allocate your training and choose a starting loadout. Your progress is saved between steps.</p><button type="button" class="inline-control" data-action="dispatch" data-command="wizard">{{creationLabel}}</button></fieldset>{{/if}}{{/unless}}
      <div class="section-heading"><h3>Character</h3>{{#if editable}}<button type="button" class="inline-control" data-action="dispatch" data-command="edit-profile">Edit character</button>{{/if}}</div>
      <div class="profile-grid character-profile">{{#each biographyFields}}<fieldset><legend>{{label}}</legend><p class="profile-text">{{#if value}}{{value}}{{else}}<span class="hint">Not recorded yet.</span>{{/if}}</p></fieldset>{{/each}}</div>
      <div class="character-overview"><fieldset><legend>At a glance</legend><dl class="summary-values"><div><dt>Trained Skills</dt><dd>{{trainedCount}}</dd></div><div><dt>Free hands</dt><dd>{{handsFree}} / 2</dd></div><div><dt>Available VP</dt><dd>{{advancement.availableVP}}</dd></div></dl><p>{{readyNames}}</p><div class="row-actions"><button type="button" data-action="dispatch" data-command="navigate" data-tab="equipment">Equipment</button><button type="button" data-action="dispatch" data-command="navigate" data-tab="advancement">Advance character</button></div></fieldset>
      <fieldset><legend>Your strongest Skills</legend>{{#each overviewSkills}}<div class="purchase-row"><span>{{label}}</span><button type="button" data-action="dispatch" data-command="test" data-skill="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Roll +{{total}}</button></div>{{else}}<p class="hint">Choose your training during character creation.</p>{{/each}}</fieldset>
      </div><fieldset><legend>Recent journal entries</legend>{{#each recentNotes}}<div class="journal-preview"><button type="button" class="inline-control" data-action="dispatch" data-command="journal-entry" data-id="{{id}}">{{title}}</button><p class="hint">{{preview}}</p></div>{{else}}<p class="hint">Keep people, leads and session notes in your Journal.</p>{{/each}}<button type="button" class="inline-control" data-action="dispatch" data-command="navigate" data-tab="memory">Open journal</button></fieldset>
    </section>
    <section class="tab {{#if isMemory}}active{{/if}}" data-group="sheet" data-tab="memory"><div class="notebook">
      <div class="sheet-toolbar"><search><input data-memory-search data-sheet-search="memory" type="search" value="{{search}}" placeholder="Search your journal…" aria-label="Search journal"></search>{{#if editable}}<button type="button" data-action="dispatch" data-command="note-add"><i class="fa-solid fa-plus" inert></i> Add entry</button>{{/if}}</div>
      <p class="hint">{{noteCount}} entries · Keep track of people, places and leads. Tags help connect related notes.</p>
      {{#each notes}}<article class="memory-entry"><div class="section-heading"><button type="button" class="journal-title" data-action="dispatch" data-command="note-open" data-id="{{id}}" aria-expanded="{{open}}">{{title}}</button>{{#if ../editable}}<div class="row-actions"><button class="icon" type="button" data-action="dispatch" data-command="note-edit" data-id="{{id}}" aria-label="Edit {{title}}"><i class="fa-solid fa-pen" inert></i></button><button class="icon" type="button" data-action="dispatch" data-command="note-delete" data-id="{{id}}" aria-label="Delete {{title}}"><i class="fa-solid fa-trash" inert></i></button></div>{{/if}}</div><div class="tag-list">{{#each tagRows}}<button type="button" class="tag inline-control" style="{{style}}" data-action="dispatch" data-command="note-tag" data-tag="{{label}}">{{label}}</button>{{/each}}</div>{{#if open}}<div class="note-content">{{{html}}}</div>{{else}}<p class="hint journal-preview">{{preview}}</p>{{/if}}</article>{{else}}<p class="hint">{{#if search}}No entries match this search.{{else}}Your journal is empty. Add an entry to record your first lead.{{/if}}</p>{{/each}}
      {{#if editable}}<details data-disclosure="journal-settings"><summary>Journal tools</summary><button type="button" class="inline-control" data-action="dispatch" data-command="tag-colour">Choose a tag colour</button></details>{{/if}}
    </div></section>
    <section class="tab {{#if isAdvancement}}active{{/if}}" data-group="sheet" data-tab="advancement">
      <div class="section-heading"><h3>Advance your character</h3>{{#if isGM}}<button type="button" class="inline-control" data-action="dispatch" data-command="award">Award VP</button>{{/if}}</div>
      <fieldset><legend>{{advancement.availableVP}} VP available</legend><dl class="summary-values"><div><dt>Earned</dt><dd>{{system.advancement.lifetimeVP}}</dd></div><div><dt>Spent</dt><dd>{{system.advancement.spentVP}}</dd></div><div><dt>Level</dt><dd>{{system.tactical.level}}</dd></div></dl>{{#if nextLevel}}<p class="hint">{{levelProgress}} more earned VP until your next level. Spending VP does not reduce your level.</p>{{else}}<p class="hint">You have reached the highest level. You can still spend available VP.</p>{{/if}}</fieldset>
      <fieldset><legend>Improve a Skill</legend><div class="profile-grid">{{#each advanceSkills}}<div class="advancement-row"><div><strong>{{label}}</strong><small class="hint">Rank {{current}}{{#if eligible}} → {{next}}{{/if}}{{#if reason}} · {{reason}}{{/if}}</small></div><button type="button" data-action="dispatch" data-command="purchase" data-kind="skill" data-key="{{id}}" {{#if purchaseDisabled}}disabled{{/if}}>{{#if eligible}}{{cost}} VP{{else}}Maximum{{/if}}</button></div>{{/each}}</div></fieldset>
      <fieldset><legend>Learn a Discipline</legend><div class="section-heading"><p class="hint">Training unlocks new equipment actions.</p><button type="button" class="inline-control" data-action="dispatch" data-command="available" aria-pressed="{{availableOnly}}">{{#if availableOnly}}Show all{{else}}Available now{{/if}}</button></div>{{#each advanceDisciplines}}<div class="advancement-row"><div><strong>{{label}}</strong><small class="hint">{{#if advanced}}Advanced · {{/if}}{{prerequisite}}{{#if benefits}} · {{benefits}}{{/if}}</small>{{#if reason}}<small class="hint">{{reason}}</small>{{/if}}</div><button type="button" data-action="dispatch" data-command="purchase" data-kind="discipline" data-key="{{id}}" {{#if purchaseDisabled}}disabled{{/if}}>{{#if current}}Learned{{else}}{{cost}} VP{{/if}}</button></div>{{else}}<p class="hint">No Disciplines are currently affordable with your training. Show all to see what to work toward.</p>{{/each}}</fieldset>
      <details data-disclosure="attribute-advancement"><summary>Improve an Attribute · one lifetime purchase</summary><div class="profile-grid">{{#each advanceAttributes}}<div class="advancement-row"><div><strong>{{label}} {{current}}</strong><small class="hint">{{#if reason}}{{reason}}{{else}}Increase to {{next}}{{/if}}</small></div><button type="button" data-action="dispatch" data-command="purchase" data-kind="attribute" data-key="{{id}}" {{#if purchaseDisabled}}disabled{{/if}}>{{cost}} VP</button></div>{{/each}}</div></details>
    </section>
  </div>
</div>
