<div class="encounter-shell">
  <header class="section-heading"><h2>Encounter · Round {{round}}</h2>{{#if isGM}}{{#unless hasCombat}}<button type="button" class="inline-control" data-action="dispatch" data-command="create">Create from selected tokens</button>{{else}}{{#unless started}}<button type="button" class="inline-control" data-action="dispatch" data-command="start">Start combat</button>{{else}}{{#if active}}<button type="button" class="inline-control" data-action="dispatch" data-command="end">End activation</button>{{else}}{{#if complete}}<button type="button" class="inline-control" data-action="dispatch" data-command="round">Next round</button>{{else}}<button type="button" class="inline-control" data-action="dispatch" data-command="draw">Draw side</button>{{/if}}{{/if}}{{/unless}}{{/unless}}{{/if}}</header>
  {{#if bag.length}}<div class="bag-row" aria-label="Remaining activations">{{#each bag}}<span>{{side}}: <strong>{{count}}</strong></span>{{/each}}</div>{{/if}}
  {{#if side}}<p class="notification info"><strong>{{side}}</strong>: choose an eligible combatant.</p>{{/if}}
  <fieldset class="encounter-list"><legend>Combatants</legend>{{#each rows}}<article class="combatant-row"><img src="{{img}}" alt=""><div><button type="button" class="combatant-name" data-action="dispatch" data-command="sheet" data-id="{{id}}">{{name}}</button><small class="hint">{{side}}{{#if hidden}} · Hidden{{/if}}{{#if active}} · Active{{/if}}{{#if activated}} · Activated{{/if}}{{#unless eligible}} · Unable to act{{/unless}}</small></div>
    {{#if showResources}}<div class="combatant-resources" aria-label="{{name}} resources"><span>{{combat.actionsRemaining}} A</span><span>{{combat.wounds}} W</span><span>{{combat.pressure}} P</span><span>{{#if combat.reactionAvailable}}1 R{{else}}0 R{{/if}}</span></div>{{/if}}
    <div class="row-actions">{{#if selectable}}<button type="button" data-action="dispatch" data-command="activate" data-id="{{id}}">Activate</button>{{/if}}{{#if reserved}}{{#if owner}}<button type="button" data-action="dispatch" data-command="shot" data-id="{{id}}">Trigger {{combat.overwatch.kind}}</button>{{/if}}{{/if}}{{#if ../isGM}}{{#unless ../started}}<button type="button" data-action="dispatch" data-command="side" data-id="{{id}}">Set side</button>{{/unless}}{{#if ambushEligible}}<button type="button" data-action="dispatch" data-command="activate" data-id="{{id}}" data-ambush="true">Ambush</button>{{/if}}{{/if}}</div>
  </article>{{else}}<p class="hint">Add combatants with the Token HUD or create an encounter from selected tokens.</p>{{/each}}</fieldset>
  <footer><p class="hint">One activation per eligible combatant. The drawn side chooses who acts. Native Combat controls use this encounter.</p></footer>
</div>
