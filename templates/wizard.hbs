<div class="wizard-shell">
  <header><h2>Character creation</h2><p class="hint">5 Attribute points · 10 Skill points · 2 basic Disciplines. Changes save automatically.</p></header>
  <nav class="tabs wizard-steps" aria-label="Creation progress">{{#each steps}}<button type="button" class="plain {{#if active}}active{{/if}}" data-action="dispatch" data-command="step" data-step="{{index}}" {{#if active}}aria-current="step"{{/if}}>{{number}}. {{label}}</button>{{/each}}</nav>
  <div class="wizard-content">
    {{#if identity}}<fieldset><legend>Identity</legend>{{#each identityFields}}<div class="form-group {{#if multiline}}stacked{{/if}}"><label for="{{../wizardId}}-{{id}}">{{label}}</label>{{#if multiline}}<textarea id="{{../wizardId}}-{{id}}" name="{{id}}" rows="3">{{value}}</textarea>{{else}}<div class="form-fields"><input id="{{../wizardId}}-{{id}}" name="{{id}}" value="{{value}}" {{#if required}}required{{/if}}></div>{{/if}}</div>{{/each}}</fieldset>{{/if}}
    {{#if attributesStep}}<fieldset><legend>Attributes</legend><p class="points" aria-live="polite"><strong>{{attributeLeft}} points remaining</strong></p><p class="hint">Each starts at zero. Spend five points; maximum two per Attribute.</p><div class="point-grid">{{#each attributes}}<div class="point-row"><span>{{label}}</span><div class="stepper"><button type="button" data-action="dispatch" data-command="point" data-kind="attributes" data-key="{{id}}" data-delta="-1" aria-label="Decrease {{label}}" {{#if min}}disabled{{/if}}>−</button><output aria-label="{{label}} rank">{{value}}</output><button type="button" data-action="dispatch" data-command="point" data-kind="attributes" data-key="{{id}}" data-delta="1" aria-label="Increase {{label}}" {{#if max}}disabled{{/if}}>+</button></div></div>{{/each}}</div></fieldset>{{/if}}
    {{#if skillsStep}}<fieldset><legend>Skills</legend><p class="points" aria-live="polite"><strong>{{skillLeft}} points remaining</strong></p><p class="hint">Spend ten points; maximum three per Skill. Two ranks in a relevant Skill unlock basic Disciplines.</p><div class="point-grid">{{#each skills}}<div class="point-row"><span>{{label}}</span><div class="stepper"><button type="button" data-action="dispatch" data-command="point" data-kind="skills" data-key="{{id}}" data-delta="-1" aria-label="Decrease {{label}}" {{#if min}}disabled{{/if}}>−</button><output aria-label="{{label}} rank">{{value}}</output><button type="button" data-action="dispatch" data-command="point" data-kind="skills" data-key="{{id}}" data-delta="1" aria-label="Increase {{label}}" {{#if max}}disabled{{/if}}>+</button></div></div>{{/each}}</div></fieldset>{{/if}}
    {{#if disciplinesStep}}<fieldset><legend>Basic Disciplines</legend><p class="points" aria-live="polite"><strong>{{disciplineLeft}} choices remaining</strong></p><p class="hint">Choose two eligible Disciplines. Compatible equipment is required to use their actions.</p>{{#each disciplines}}<div class="purchase-row"><span>{{name}}<small class="hint">Requires {{skillLabel}} {{rank}}</small></span><button type="button" data-action="dispatch" data-command="discipline" data-id="{{id}}" aria-pressed="{{selected}}" {{#if disabled}}disabled{{/if}}>{{#if selected}}Remove{{else}}Select{{/if}}</button></div>{{/each}}</fieldset>{{/if}}
    {{#if loadoutStep}}<fieldset><legend>Starting loadout</legend><p class="hint">Choose a GM-approved loadout. Each firearm receives three compatible ammunition sources. Worn protection uses no slot.</p>{{#each loadoutSlots}}<div class="form-group"><label for="{{../wizardId}}-{{id}}">{{label}}</label><div class="form-fields"><select id="{{../wizardId}}-{{id}}" name="{{id}}">{{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>{{#if preview}}<div class="wizard-loadout-preview"><img src="{{preview.img}}" alt=""><div><strong>{{preview.name}}</strong><p>{{preview.profile}}</p></div></div>{{/if}}</div>{{/each}}</fieldset>{{/if}}
    {{#if review}}<fieldset><legend>Review {{draft.name}}</legend><dl class="summary-values"><div><dt>Attribute points left</dt><dd>{{attributeLeft}}</dd></div><div><dt>Skill points left</dt><dd>{{skillLeft}}</dd></div><div><dt>Discipline choices left</dt><dd>{{disciplineLeft}}</dd></div></dl>{{#if errors.length}}<ul class="notification warning">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p class="notification info">Ready to create.</p>{{/if}}<dl class="summary-values">{{#each reviewAttributes}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl><p><strong>Trained Skills:</strong> {{reviewSkills}}</p><p><strong>Disciplines:</strong> {{reviewDisciplines}}</p><div class="wizard-review-loadout">{{#each loadoutSlots}}<div><strong>{{label}}:</strong>{{#if preview}}<div class="wizard-loadout-preview"><img src="{{preview.img}}" alt=""><div><strong>{{preview.name}}</strong><p>{{preview.profile}}</p></div></div>{{else}} {{selectedName}}{{/if}}</div>{{/each}}</div><p class="hint">Level 1 · zero Wounds, Pressure and VP. Equipment is issued once. Return to any step before creating the character.</p></fieldset>{{/if}}
  </div>
  <footer class="wizard-footer"><button type="button" data-action="dispatch" data-command="back" {{#if first}}disabled{{/if}}>Back</button>{{#if last}}<button type="button" data-action="dispatch" data-command="finish" {{#if errors.length}}disabled{{/if}}>Create character</button>{{else}}<button type="button" data-action="dispatch" data-command="next">Next</button>{{/if}}</footer>
</div>
