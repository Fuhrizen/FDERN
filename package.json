{
  "name": "fdern-foundry",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "FDERN game system for Foundry Virtual Tabletop v14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "build:packs": "node tools/build-packs.mjs",
    "build": "npm run build:styles && python3 tools/package.py",
    "test:ui": "node tools/test-ui.mjs",
    "validate": "npm test && npm run check && npm run build:packs && npm run build",
    "build:styles": "node tools/build-styles.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "3.0.5",
    "handlebars": "4.7.8",
    "playwright": "1.56.1"
  }
}
